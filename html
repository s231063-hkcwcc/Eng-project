            document.getElementById("lblMedStatusTitle").innerText = t.medStatusTitle;
            document.getElementById("lblLatestBPTitle").innerText = t.latestBPTitle;
            document.getElementById("lblNextVisitTitle").innerText = t.nextVisitTitle;
            document.getElementById("lblMedicineSchedule").innerText = t.medSchedule;
            document.getElementById("btnAddMed").innerText = t.addMed;

            // Calendar & ID Cards Labels
            document.getElementById("lblMonthlyCalendarTitle").innerText = t.monthlyCalendar;
            document.getElementById("lblCalendarSub").innerText = t.calendarSub;
            document.getElementById("lblIdCardTitle").innerText = t.idCardTitle;
            document.getElementById("btnEditCard").innerText = t.editCard;
            document.getElementById("lblIdCardType").innerText = t.idCardType;
            document.getElementById("lblHealthCardType").innerText = t.healthCardType;
            document.getElementById("lblIdNumberLabel").innerText = t.idNumberLabel;
            document.getElementById("lblHealthNumberLabel").innerText = t.healthNumberLabel;
            document.getElementById("btnShowQr").innerText = t.showQr;

            // Font options
            document.getElementById("optFontNormal").innerText = t.normal;
            document.getElementById("optFontLarge").innerText = t.large;
            document.getElementById("optFontExtra").innerText = t.extraLarge;

            // ID & Health Card Data
            document.getElementById("displayIdName").innerText = profile.name;
            document.getElementById("displayIdNumber").innerText = profile.idNo;
            document.getElementById("displayHealthName").innerText = profile.name + " Health Card";
            document.getElementById("displayHealthNumber").innerText = profile.healthNo;

            // Medication Status Render
            const btnTakeMed = document.getElementById("btnTakeMed");
            const btnTextTakeMed = document.getElementById("btnTextTakeMed");
            const medStatusBadge = document.getElementById("medStatusBadge");
            const familyMedStatusText = document.getElementById("familyMedStatusText");

            if (profile.medTaken) {
                btnTakeMed.className = "w-full bg-slate-300 text-slate-600 font-bold text-xl py-5 rounded-2xl shadow flex items-center justify-center space-x-3 cursor-not-allowed";
                btnTextTakeMed.innerText = t.medTakenStatus;
                medStatusBadge.className = "bg-emerald-100 text-emerald-800 text-xs px-3 py-1 rounded-full font-bold";
                medStatusBadge.innerText = t.medTakenStatus;
                familyMedStatusText.className = "text-lg font-bold text-emerald-600 mt-1";
                familyMedStatusText.innerText = "✓ " + t.medTakenStatus;
            } else {
                btnTakeMed.className = "w-full bg-emerald-600 hover:bg-emerald-700 text-white font-black text-xl py-5 rounded-2xl shadow-lg transition transform active:scale-95 flex items-center justify-center space-x-3";
                btnTextTakeMed.innerText = t.takeMedBtn;
                medStatusBadge.className = "bg-amber-100 text-amber-800 text-xs px-3 py-1 rounded-full font-bold";
                medStatusBadge.innerText = t.medPendingStatus;
                familyMedStatusText.className = "text-lg font-bold text-amber-600 mt-1";
                familyMedStatusText.innerText = "⏳ " + t.medPendingStatus;
            }

            // Render First Medicine on Home
            if (profile.medicines.length > 0) {
                document.getElementById("medName").innerText = profile.medicines[0].name;
                document.getElementById("medDosage").innerText = profile.medicines[0].dosage;
                document.getElementById("medTypeBadge").innerText = profile.medicines[0].type;
            } else {
                document.getElementById("medName").innerText = "No medicines scheduled";
                document.getElementById("medDosage").innerText = "Click 'Add Medicine' to create one";
                document.getElementById("medTypeBadge").innerText = "-";
            }

            // Render Medicine List in Family View
            let medListHTML = "";
            profile.medicines.forEach((m, idx) => {
                medListHTML += `
                    <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 flex justify-between items-center">
                        <div>
                            <h4 class="font-bold text-slate-800">${m.name}</h4>
                            <p class="text-xs text-slate-500 mt-0.5">${m.dosage}</p>
                            <span class="inline-block mt-1 bg-indigo-100 text-indigo-800 text-xs px-2 py-0.5 rounded font-semibold">${m.type}</span>
                        </div>
                        <button onclick="removeMedicine(${idx})" class="text-rose-500 hover:text-rose-700 text-sm font-bold">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </div>
                `;
            });
            document.getElementById("medicineListContainer").innerText = ""; // Clear
            document.getElementById("medicineListContainer").innerHTML = medListHTML;

            // Render Photo Logs
            let photoHTML = "";
            profile.photoLogs.forEach(p => {
                photoHTML += `
                    <div class="bg-indigo-50 border border-indigo-200 p-3 rounded-xl flex items-center justify-between text-sm">
                        <div class="flex items-center space-x-3">
                            <i class="fa-solid fa-image text-indigo-600 text-xl"></i>
                            <div>
                                <p class="font-bold text-slate-800">${p.type}: ${p.text}</p>
                                <span class="text-xs text-slate-400">${p.time}</span>
                            </div>
                        </div>
                        <span class="bg-emerald-100 text-emerald-800 text-xs px-2 py-1 rounded font-bold">Saved ✓</span>
                    </div>
                `;
            });
            document.getElementById("photoLogContainer").innerHTML = photoHTML;
        }

        // Confirm Taking Medicine
        function confirmTakeMed() {
            appData[currentProfileKey].medTaken = true;
            renderApp();
            alert("Medication confirmed successfully! Family member has been notified.");
        }

        // Simulate Taking Photo of BP or Report
        function simulateTakePhoto(type) {
            const val = type === "Blood Pressure" ? "122 / 80 mmHg (Good)" : "Blood Test: Cholesterol normal";
            appData[currentProfileKey].photoLogs.unshift({
                type: type,
                text: val,
                time: "Just now"
            });
            renderApp();
            alert("Photo captured and stored securely in app records!");
        }

        // Render 31 Days Monthly Calendar
        function renderCalendarDays() {
            let html = "";
            for (let i = 1; i <= 31; i++) {
                let isHospitalVisit = (i === 16 || i === 30);
                let isMedTakenDay = (i <= 13);
                
                let bgClass = "bg-white border-slate-200 hover:bg-slate-50";
                let badge = "";

                if (isHospitalVisit) {
                    bgClass = "bg-rose-50 border-rose-300 text-rose-800 font-bold";
                    badge = `<span class="block text-[10px] bg-rose-600 text-white rounded mt-1 px-1">Hospital</span>`;
                } else if (isMedTakenDay) {
                    badge = `<span class="block text-[10px] text-emerald-600 font-bold mt-1">✓ Meds</span>`;
                }

                html += `
                    <div onclick="selectCalendarDay(${i}, ${isHospitalVisit})" class="border ${bgClass} p-2 rounded-xl cursor-pointer flex flex-col items-center justify-center min-h-[60px] transition">
                        <span class="text-sm">${i}</span>
                        ${badge}
                    </div>
                `;
            }
            document.getElementById("calendarDaysGrid").innerHTML = html;
        }

        function selectCalendarDay(day, isHospital) {
            const box = document.getElementById("calendarSelectedBox");
            const title = document.getElementById("selectedDateTitle");
            const desc = document.getElementById("selectedDateDesc");
            
            box.classList.remove("hidden");
            title.innerText = `October ${day}, 2026`;
            if (isHospital) {
                desc.innerText = "🏥 Hospital Visit scheduled at Central Hospital (Level 3, Room 302). Bring ID Card and previous blood pressure records.";
            } else {
                desc.innerText = "✓ Medication compliance verified for this day. Blood pressure within normal range.";
            }
        }

        // Modal Controls for ID Cards
        function openEditIdModal() {
            const profile = appData[currentProfileKey];
            document.getElementById("inputModalName").value = profile.name;
            document.getElementById("inputModalIdNo").value = profile.idNo;
            document.getElementById("inputModalHealthNo").value = profile.healthNo;
            document.getElementById("modalEditId").classList.remove("hidden");
        }

        function closeEditIdModal() {
            document.getElementById("modalEditId").classList.add("hidden");
        }

        function saveIdModal() {
            const profile = appData[currentProfileKey];
            profile.name = document.getElementById("inputModalName").value;
            profile.idNo = document.getElementById("inputModalIdNo").value;
            profile.healthNo = document.getElementById("inputModalHealthNo").value;
            closeEditIdModal();
            renderApp();
            alert("ID and Health Card details updated successfully!");
        }

        // Modal Controls for Add Medicine
        function openAddMedModal() {
            document.getElementById("inputMedName").value = "";
            document.getElementById("inputMedDosage").value = "";
            document.getElementById("modalAddMed").classList.remove("hidden");
        }

        function closeAddMedModal() {
            document.getElementById("modalAddMed").classList.add("hidden");
        }

        function saveNewMedicine() {
            const name = document.getElementById("inputMedName").value;
            const type = document.getElementById("inputMedType").value;
            const dosage = document.getElementById("inputMedDosage").value;

            if (!name) {
                alert("Please enter medicine name");
                return;
            }

            appData[currentProfileKey].medicines.push({ name, type, dosage });
            closeAddMedModal();
            renderApp();
            alert("New medicine added successfully!");
        }

        function removeMedicine(index) {
            appData[currentProfileKey].medicines.splice(index, 1);
            renderApp();
        }

        // Add Profile Modal
        function openAddProfileModal() {
            const name = prompt("Enter new profile name (e.g., Uncle John / Grandma):");
            if (name) {
                const key = "custom_" + Date.now();
                appData[key] = {
                    name: name,
                    idNo: "Z999999(9)",
                    healthNo: "HC-CUSTOM-00",
                    medTaken: false,
                    medicines: [{ name: "Daily Vitamin", type: "Pill / Tablet", dosage: "1 Tablet daily" }],
                    photoLogs: []
                };

                const select = document.getElementById("profileSelect");
                const opt = document.createElement("option");
                opt.value = key;
                opt.innerText = "👤 " + name;
                select.appendChild(opt);
                select.value = key;
                switchProfile(key);
            }
        }
    </script>
</body>
</html>

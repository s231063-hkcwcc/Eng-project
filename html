<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CareConnect - Health & Medication Tracker</title>
    <!-- Tailwind CSS for modern styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .font-normal-size { font-size: 1rem; }
        .font-large-size { font-size: 1.15rem; }
        .font-extralarge-size { font-size: 1.35rem; }
    </style>
</head>
<body id="appBody" class="bg-slate-100 text-slate-800 font-normal-size min-h-screen flex flex-col">

    <!-- TOP HEADER BAR -->
    <header class="bg-indigo-600 text-white shadow-md p-4 flex flex-wrap justify-between items-center gap-3">
        <div class="flex items-center space-x-2">
            <i class="fa-solid fa-heart-pulse text-2xl text-rose-300"></i>
            <h1 id="uiAppTitle" class="text-xl font-bold tracking-wide">CareConnect (家安药历)</h1>
        </div>

        <!-- CONTROLS: Language, Font Size, Mode -->
        <div class="flex items-center space-x-3 flex-wrap">
            <!-- Language Selector -->
            <div class="flex items-center bg-indigo-700 rounded px-2 py-1">
                <i class="fa-solid fa-globe text-xs mr-1 text-indigo-200"></i>
                <select id="languageSelect" onchange="changeLanguage(this.value)" class="bg-transparent text-white text-sm outline-none cursor-pointer">
                    <option value="en" class="text-slate-800">English</option>
                    <option value="zh-CN" class="text-slate-800" selected>简体中文</option>
                    <option value="zh-TW" class="text-slate-800">繁體中文</option>
                    <option value="es" class="text-slate-800">Español</option>
                    <option value="ja" class="text-slate-800">日本語</option>
                    <option value="ko" class="text-slate-800">한국어</option>
                    <option value="vi" class="text-slate-800">Tiếng Việt</option>
                    <option value="tl" class="text-slate-800">Tagalog</option>
                </select>
            </div>

            <!-- Font Size Toggle -->
            <div class="flex items-center bg-indigo-700 rounded px-2 py-1 space-x-1">
                <i class="fa-solid fa-text-height text-xs text-indigo-200"></i>
                <select id="fontSizeSelect" onchange="changeFontSize(this.value)" class="bg-transparent text-white text-sm outline-none cursor-pointer">
                    <option value="normal" class="text-slate-800" id="optFontNormal">Normal</option>
                    <option value="large" class="text-slate-800" id="optFontLarge">Large</option>
                    <option value="extralarge" class="text-slate-800" id="optFontExtra">Extra Large</option>
                </select>
            </div>
        </div>
    </header>

    <!-- MAIN CONTAINER -->
    <main class="flex-1 max-w-4xl w-full mx-auto p-4 flex flex-col gap-6">

        <!-- PROFILE & MODE SELECTOR -->
        <section class="bg-white rounded-xl shadow p-4 flex flex-col md:flex-row justify-between items-center gap-4">
            <!-- Profile Switcher -->
            <div class="flex items-center space-x-3 w-full md:w-auto">
                <span class="font-bold text-slate-600" id="lblProfile">Profile:</span>
                <select id="profileSelect" onchange="switchProfile(this.value)" class="border border-slate-300 rounded-lg px-3 py-2 bg-slate-50 font-semibold text-indigo-600 outline-none">
                    <option value="self">👤 Myself / 我自己</option>
                    <option value="dad">👴 Dad / 爸爸 (Senior)</option>
                    <option value="mom">👵 Mom / 妈妈 (Senior)</option>
                </select>
                <button onclick="openAddProfileModal()" class="bg-indigo-100 text-indigo-700 px-3 py-2 rounded-lg font-medium hover:bg-indigo-200 text-sm">
                    <i class="fa-solid fa-user-plus mr-1"></i> <span id="btnAddProfileText">Add</span>
                </button>
            </div>

            <!-- Mode Toggle Switch (Elderly vs Family) -->
            <div class="flex bg-slate-200 p-1 rounded-xl w-full md:w-auto">
                <button onclick="switchMode('elderly')" id="btnModeElderly" class="flex-1 md:flex-initial px-4 py-2 rounded-lg font-bold transition text-sm bg-white text-indigo-600 shadow">
                    <i class="fa-solid fa-hand-holding-heart mr-1"></i> <span id="lblModeElderly">Patient / Elderly Mode</span>
                </button>
                <button onclick="switchMode('family')" id="btnModeFamily" class="flex-1 md:flex-initial px-4 py-2 rounded-lg font-bold transition text-sm text-slate-600">
                    <i class="fa-solid fa-users mr-1"></i> <span id="lblModeFamily">Family / Caregiver Mode</span>
                </button>
            </div>
        </section>

        <!-- NAVIGATION TABS -->
        <div class="flex border-b border-slate-200 space-x-6">
            <button onclick="switchTab('home')" id="tabHome" class="pb-2 font-bold border-b-2 border-indigo-600 text-indigo-600 flex items-center space-x-2">
                <i class="fa-solid fa-house"></i> <span id="lblTabHome">Home & Meds</span>
            </button>
            <button onclick="switchTab('calendar')" id="tabCalendar" class="pb-2 font-bold text-slate-500 hover:text-indigo-600 flex items-center space-x-2">
                <i class="fa-solid fa-calendar-days"></i> <span id="lblTabCalendar">Hospital Calendar</span>
            </button>
            <button onclick="switchTab('idcards')" id="tabIdCards" class="pb-2 font-bold text-slate-500 hover:text-indigo-600 flex items-center space-x-2">
                <i class="fa-solid fa-id-card"></i> <span id="lblTabIdCards">ID & Health Cards</span>
            </button>
        </div>

        <!-- ================= TAB 1: HOME & MEDS ================= -->
        <div id="sectionHome" class="space-y-6">
            <!-- PATIENT / ELDERLY VIEW -->
            <div id="viewElderly" class="space-y-6">
                <!-- Hospital Countdown Banner -->
                <div class="bg-gradient-to-r from-rose-500 to-pink-600 text-white p-5 rounded-2xl shadow-lg flex justify-between items-center">
                    <div>
                        <span class="bg-rose-700 text-xs px-2 py-1 rounded-full uppercase tracking-wider font-bold" id="badgeHospital">Hospital Visit</span>
                        <h2 class="text-xl font-bold mt-2" id="txtHospitalCountdown">Dr. Wong Appointment in 3 Days</h2>
                        <p class="text-sm text-rose-100 mt-1" id="txtHospitalDetails">📍 Central Hospital - Level 3, Room 302</p>
                    </div>
                    <i class="fa-solid fa-hospital-user text-4xl text-rose-200 opacity-80"></i>
                </div>

                <!-- Medication Reminder Card -->
                <div class="bg-white p-6 rounded-2xl shadow-md border-2 border-indigo-100 space-y-4">
                    <div class="flex justify-between items-center">
                        <h3 class="font-bold text-lg text-slate-700 flex items-center">
                            <i class="fa-solid fa-pills text-indigo-600 mr-2"></i> <span id="lblNextMed">Next Medication</span>
                        </h3>
                        <span id="medStatusBadge" class="bg-amber-100 text-amber-800 text-xs px-3 py-1 rounded-full font-bold">Pending ⏳</span>
                    </div>

                    <div class="bg-indigo-50 p-4 rounded-xl flex items-center justify-between">
                        <div>
                            <h4 id="medName" class="text-xl font-extrabold text-indigo-950">Amlodipine (Blood Pressure)</h4>
                            <p id="medDosage" class="text-sm text-indigo-700 mt-1">1 Tablet • Take with water after breakfast</p>
                            <span id="medTypeBadge" class="inline-block mt-2 bg-indigo-200 text-indigo-800 text-xs px-2 py-0.5 rounded font-semibold">💊 Pill / Tablet</span>
                        </div>
                        <div class="text-3xl text-indigo-400">08:00 AM</div>
                    </div>

                    <!-- GIANT BUTTON FOR ELDERLY -->
                    <button onclick="confirmTakeMed()" id="btnTakeMed" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-black text-xl py-5 rounded-2xl shadow-lg transition transform active:scale-95 flex items-center justify-center space-x-3">
                        <i class="fa-solid fa-circle-check text-2xl"></i>
                        <span id="btnTextTakeMed">I HAVE TAKEN MY MEDICINE</span>
                    </button>
                </div>

                <!-- Quick Photo Log (BP & Reports) -->
                <div class="bg-white p-6 rounded-2xl shadow-md space-y-4">
                    <h3 class="font-bold text-lg text-slate-700 flex items-center">
                        <i class="fa-solid fa-camera text-indigo-600 mr-2"></i> <span id="lblPhotoLog">Quick Photo Log (BP & Reports)</span>
                    </h3>
                    <p class="text-sm text-slate-500" id="lblPhotoLogSub">Snap a photo of your blood pressure monitor or medical report to save instantly.</p>
                    
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <button onclick="simulateTakePhoto('Blood Pressure')" class="border-2 border-dashed border-indigo-300 hover:border-indigo-600 bg-indigo-50 hover:bg-indigo-100 p-4 rounded-xl flex flex-col items-center justify-center text-indigo-700 transition">
                            <i class="fa-solid fa-gauge text-3xl mb-2"></i>
                            <span class="font-bold" id="btnSnapBP">Snap Blood Pressure</span>
                        </button>
                        <button onclick="simulateTakePhoto('Medical Report')" class="border-2 border-dashed border-indigo-300 hover:border-indigo-600 bg-indigo-50 hover:bg-indigo-100 p-4 rounded-xl flex flex-col items-center justify-center text-indigo-700 transition">
                            <i class="fa-solid fa-file-medical text-3xl mb-2"></i>
                            <span class="font-bold" id="btnSnapReport">Snap Medical Report</span>
                        </button>
                    </div>

                    <div id="photoLogContainer" class="mt-4 space-y-2">
                        <!-- Dynamically populated photo records -->
                    </div>
                </div>
            </div>

            <!-- FAMILY / CAREGIVER VIEW -->
            <div id="viewFamily" class="hidden space-y-6">
                <!-- Status Overview Board -->
                <div class="bg-white p-6 rounded-2xl shadow-md space-y-4">
                    <div class="flex justify-between items-center">
                        <h3 class="font-bold text-lg text-slate-700 flex items-center">
                            <i class="fa-solid fa-shield-heart text-indigo-600 mr-2"></i> <span id="lblFamilyDashboard">Caregiver Live Status Dashboard</span>
                        </h3>
                        <span class="text-xs bg-emerald-100 text-emerald-800 px-3 py-1 rounded-full font-bold" id="lblLiveSync">● Real-time Synced</span>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200">
                            <span class="text-xs text-slate-500 font-semibold uppercase" id="lblMedStatusTitle">Medication Today</span>
                            <p id="familyMedStatusText" class="text-lg font-bold text-amber-600 mt-1">⏳ Pending Confirmation</p>
                        </div>
                        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200">
                            <span class="text-xs text-slate-500 font-semibold uppercase" id="lblLatestBPTitle">Latest Blood Pressure</span>
                            <p id="familyBpText" class="text-lg font-bold text-indigo-600 mt-1">125 / 82 mmHg (Normal)</p>
                        </div>
                        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200">
                            <span class="text-xs text-slate-500 font-semibold uppercase" id="lblNextVisitTitle">Next Hospital Visit</span>
                            <p id="familyVisitText" class="text-lg font-bold text-rose-600 mt-1">Oct 16, 2026 (3 days)</p>
                        </div>
                    </div>
                </div>

                <!-- Manage Medicine List & Add Medicine -->
                <div class="bg-white p-6 rounded-2xl shadow-md space-y-4">
                    <div class="flex justify-between items-center">
                        <h3 class="font-bold text-lg text-slate-700 flex items-center">
                            <i class="fa-solid fa-list-check text-indigo-600 mr-2"></i> <span id="lblMedicineSchedule">Medication Schedule & Types</span>
                        </h3>
                        <button onclick="openAddMedModal()" class="bg-indigo-600 hover:bg-indigo-700 text-white px-3 py-2 rounded-lg font-bold text-sm">
                            <i class="fa-solid fa-plus mr-1"></i> <span id="btnAddMed">Add Medicine</span>
                        </button>
                    </div>

                    <div id="medicineListContainer" class="space-y-3">
                        <!-- Populated medicine items -->
                    </div>
                </div>
            </div>
        </div>

        <!-- ================= TAB 2: HOSPITAL CALENDAR ================= -->
        <div id="sectionCalendar" class="hidden space-y-6">
            <div class="bg-white p-6 rounded-2xl shadow-md space-y-4">
                <div class="flex justify-between items-center">
                    <h3 class="font-bold text-lg text-slate-700 flex items-center">
                        <i class="fa-solid fa-calendar-days text-indigo-600 mr-2"></i> <span id="lblMonthlyCalendarTitle">Monthly Hospital & Health Calendar</span>
                    </h3>
                    <span class="text-sm font-semibold text-indigo-600" id="currentMonthYear">October 2026</span>
                </div>
                <p class="text-sm text-slate-500" id="lblCalendarSub">Tap any date to check scheduled hospital visits and medication compliance.</p>

                <!-- Grid Calendar (31 Days) -->
                <div class="grid grid-cols-7 gap-2 text-center text-sm">
                    <div class="font-bold text-slate-400">Mon</div>
                    <div class="font-bold text-slate-400">Tue</div>
                    <div class="font-bold text-slate-400">Wed</div>
                    <div class="font-bold text-slate-400">Thu</div>
                    <div class="font-bold text-slate-400">Fri</div>
                    <div class="font-bold text-slate-400">Sat</div>
                    <div class="font-bold text-slate-400">Sun</div>

                    <!-- Days loop generated via script -->
                    <div id="calendarDaysGrid" class="contents"></div>
                </div>

                <!-- Selected Date Info Box -->
                <div id="calendarSelectedBox" class="bg-indigo-50 border border-indigo-200 p-4 rounded-xl mt-4 hidden">
                    <h4 class="font-bold text-indigo-900" id="selectedDateTitle">Date Details</h4>
                    <p class="text-sm text-indigo-700 mt-1" id="selectedDateDesc">No special events scheduled.</p>
                </div>
            </div>
        </div>

        <!-- ================= TAB 3: ID & HEALTH CARDS ================= -->
        <div id="sectionIdCards" class="hidden space-y-6">
            <div class="bg-white p-6 rounded-2xl shadow-md space-y-6">
                <div class="flex justify-between items-center">
                    <h3 class="font-bold text-lg text-slate-700 flex items-center">
                        <i class="fa-solid fa-id-card text-indigo-600 mr-2"></i> <span id="lblIdCardTitle">ID & Health Card Details</span>
                    </h3>
                    <button onclick="openEditIdModal()" class="bg-indigo-600 hover:bg-indigo-700 text-white px-3 py-2 rounded-lg font-bold text-sm">
                        <i class="fa-solid fa-pen-to-square mr-1"></i> <span id="btnEditCard">Edit Details</span>
                    </button>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- ID Card Card -->
                    <div class="bg-gradient-to-br from-slate-800 to-slate-900 text-white p-5 rounded-2xl shadow-lg flex flex-col justify-between">
                        <div class="flex justify-between items-start">
                            <div>
                                <span class="text-xs text-slate-400 uppercase tracking-wider font-bold" id="lblIdCardType">Identity Card (ID)</span>
                                <h4 id="displayIdName" class="text-xl font-bold mt-1">John Doe</h4>
                            </div>
                            <i class="fa-solid fa-address-card text-3xl text-slate-400"></i>
                        </div>
                        <div class="mt-6">
                            <span class="text-xs text-slate-400" id="lblIdNumberLabel">ID Number:</span>
                            <p id="displayIdNumber" class="text-lg font-mono font-bold tracking-widest">A123456(7)</p>
                        </div>
                    </div>

                    <!-- Health / Medical Card -->
                    <div class="bg-gradient-to-br from-indigo-800 to-indigo-950 text-white p-5 rounded-2xl shadow-lg flex flex-col justify-between">
                        <div class="flex justify-between items-start">
                            <div>
                                <span class="text-xs text-indigo-300 uppercase tracking-wider font-bold" id="lblHealthCardType">Health / Medical Insurance Card</span>
                                <h4 id="displayHealthName" class="text-xl font-bold mt-1">Hospital Authority / eHealth</h4>
                            </div>
                            <i class="fa-solid fa-notes-medical text-3xl text-indigo-300"></i>
                        </div>
                        <div class="mt-6 flex justify-between items-end">
                            <div>
                                <span class="text-xs text-indigo-300" id="lblHealthNumberLabel">Card / Member No:</span>
                                <p id="displayHealthNumber" class="text-lg font-mono font-bold tracking-wider">HC-99882233-X</p>
                            </div>
                            <button onclick="alert('Card barcode/QR code scanned successfully for hospital admission.')" class="bg-white text-indigo-900 px-3 py-1.5 rounded-lg font-bold text-xs">
                                <i class="fa-solid fa-qrcode mr-1"></i> <span id="btnShowQr">Show QR</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </main>

    <!-- FOOTER -->
    <footer class="text-center py-6 text-slate-400 text-sm">
        CareConnect © 2026 • Elderly & Patient Health Management Platform
    </footer>

    <!-- MODAL: EDIT ID & HEALTH CARDS -->
    <div id="modalEditId" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 hidden z-50">
        <div class="bg-white rounded-2xl max-w-md w-full p-6 space-y-4 shadow-xl">
            <h3 class="font-bold text-lg text-slate-800" id="modalIdTitle">Edit ID & Health Card Details</h3>
            <div class="space-y-3">
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1" id="lblModalFullName">Full Name</label>
                    <input type="text" id="inputModalName" class="w-full border border-slate-300 rounded-lg p-2 outline-none focus:border-indigo-600">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1" id="lblModalIdNo">ID Card Number</label>
                    <input type="text" id="inputModalIdNo" class="w-full border border-slate-300 rounded-lg p-2 outline-none focus:border-indigo-600">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1" id="lblModalHealthNo">Health Card / Insurance No</label>
                    <input type="text" id="inputModalHealthNo" class="w-full border border-slate-300 rounded-lg p-2 outline-none focus:border-indigo-600">
                </div>
            </div>
            <div class="flex justify-end space-x-2 pt-2">
                <button onclick="closeEditIdModal()" class="px-4 py-2 bg-slate-200 text-slate-700 rounded-lg font-bold text-sm" id="btnModalCancel">Cancel</button>
                <button onclick="saveIdModal()" class="px-4 py-2 bg-indigo-600 text-white rounded-lg font-bold text-sm" id="btnModalSave">Save</button>
            </div>
        </div>
    </div>

    <!-- MODAL: ADD MEDICINE -->
    <div id="modalAddMed" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 hidden z-50">
        <div class="bg-white rounded-2xl max-w-md w-full p-6 space-y-4 shadow-xl">
            <h3 class="font-bold text-lg text-slate-800" id="modalMedTitle">Add New Medicine</h3>
            <div class="space-y-3">
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1" id="lblMedNameInput">Medicine Name</label>
                    <input type="text" id="inputMedName" placeholder="e.g. Metformin" class="w-full border border-slate-300 rounded-lg p-2 outline-none focus:border-indigo-600">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1" id="lblMedTypeInput">Medicine Type</label>
                    <select id="inputMedType" class="w-full border border-slate-300 rounded-lg p-2 outline-none focus:border-indigo-600">
                        <option value="Pill / Tablet">💊 Pill / Tablet (片剂)</option>
                        <option value="Liquid / Syrup">🧪 Liquid / Syrup (口服液)</option>
                        <option value="Injection">💉 Injection (注射)</option>
                        <option value="Drops">💧 Drops (滴剂)</option>
                        <option value="Patch">🩹 Patch (贴剂)</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1" id="lblMedDosageInput">Dosage & Instructions</label>
                    <input type="text" id="inputMedDosage" placeholder="e.g. 1 Tablet after lunch" class="w-full border border-slate-300 rounded-lg p-2 outline-none focus:border-indigo-600">
                </div>
            </div>
            <div class="flex justify-end space-x-2 pt-2">
                <button onclick="closeAddMedModal()" class="px-4 py-2 bg-slate-200 text-slate-700 rounded-lg font-bold text-sm" id="btnMedCancel">Cancel</button>
                <button onclick="saveNewMedicine()" class="px-4 py-2 bg-indigo-600 text-white rounded-lg font-bold text-sm" id="btnMedSave">Add</button>
            </div>
        </div>
    </div>

    <!-- JAVASCRIPT LOGIC -->
